---
import "../styles/global.css";
import seo from "../data/seo.json";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = seo.site.title || "Mohammad Samadi",
  description = seo.site.description || "Portfolio and contact for Mohammad Samadi.",
} = Astro.props;

const favicon = seo.site.favicon || "/media/mohammad-amin.webp";
const appleTouchIcon = seo.site.appleTouchIcon || favicon;
const ogImage = seo.site.ogImage;
const googleAnalytics = seo.site.googleAnalytics;
---

<!doctype html>
<html lang="en" class="h-full w-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={favicon} />
    <link rel="apple-touch-icon" href={appleTouchIcon} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {
      googleAnalytics && (
        <>
          <script
            is:inline
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalytics}`}
          />
          <script is:inline define:vars={{ googleAnalytics }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", googleAnalytics);
          </script>
        </>
      )
    }
    <!-- Outfit (variable) — matches the Vite app's @fontsource-variable/outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="h-full w-full">
    <slot />

    <script>
      // Scroll-reveal — replaces framer-motion whileInView.
      const reduce = window.matchMedia(
        "(prefers-reduced-motion: reduce)"
      ).matches;
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if (reduce) {
        els.forEach((el) => el.classList.add("in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.2 }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
