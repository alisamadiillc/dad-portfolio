---
// Drag-slider before/after comparison. The after image is the base layer; the
// before image sits on top, clipped to the left of a draggable divider. Ported
// 1:1 from the Vite app's before-after-slider.tsx, logic moved to a scoped script.
interface Props {
  beforeSrc: string;
  afterSrc: string;
  alt?: string;
  class?: string;
}
const { beforeSrc, afterSrc, alt = "", class: className = "" } = Astro.props;
---

<div
  data-baslider
  class:list={["relative w-full overflow-hidden select-none", className]}
>
  <img
    src={afterSrc}
    alt={alt}
    loading="lazy"
    draggable="false"
    class="block w-full"
  />
  <img
    data-before
    src={beforeSrc}
    alt=""
    aria-hidden="true"
    loading="lazy"
    draggable="false"
    class="absolute inset-0 size-full object-cover"
    style="clip-path: inset(0 50% 0 0)"
  />

  <div
    data-line
    class="pointer-events-none absolute inset-y-0 w-0.5 -translate-x-1/2 bg-white shadow-[0_0_4px_rgba(0,0,0,0.4)]"
    style="left: 50%"
  >
  </div>

  <div
    data-handle
    role="slider"
    tabindex="0"
    aria-label="Before and after comparison"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="50"
    class="absolute top-1/2 -translate-x-1/2 -translate-y-1/2 cursor-ew-resize touch-none rounded-full border border-white bg-black/60 p-1.5 text-white outline-none focus-visible:ring-2 focus-visible:ring-white"
    style="left: 50%"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="m9 7-5 5 5 5"></path>
      <path d="m15 7 5 5-5 5"></path>
    </svg>
  </div>

  <span
    class="pointer-events-none absolute top-2 left-2 rounded-full bg-black/60 px-2 py-0.5 text-xs font-medium text-white"
    >Before</span
  >
  <span
    class="pointer-events-none absolute top-2 right-2 rounded-full bg-black/60 px-2 py-0.5 text-xs font-medium text-white"
    >After</span
  >

  <button
    type="button"
    data-expand
    data-lightbox={afterSrc}
    data-lightbox-group={JSON.stringify([beforeSrc, afterSrc])}
    data-lightbox-index="1"
    data-lightbox-alt={alt}
    aria-label="View full image"
    class="absolute right-2 bottom-2 rounded-full border border-white bg-black/60 p-1.5 text-white outline-none focus-visible:ring-2 focus-visible:ring-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-4"
    >
      <path d="M15 3h6v6"></path>
      <path d="M9 21H3v-6"></path>
      <path d="M21 3l-7 7"></path>
      <path d="M3 21l7-7"></path>
    </svg>
  </button>
</div>

<script>
  const clamp = (n: number) => Math.min(100, Math.max(0, n));

  function initSlider(root: HTMLElement) {
    const before = root.querySelector<HTMLElement>("[data-before]");
    const line = root.querySelector<HTMLElement>("[data-line]");
    const handle = root.querySelector<HTMLElement>("[data-handle]");
    const expand = root.querySelector<HTMLElement>("[data-expand]");
    if (!before || !line || !handle) return;

    // Keep the maximize button from starting a divider drag; its click still
    // bubbles to the shared Lightbox (bound via data-lightbox).
    expand?.addEventListener("pointerdown", (e) => e.stopPropagation());

    let pos = 50;
    let dragging = false;

    const apply = () => {
      before.style.clipPath = `inset(0 ${100 - pos}% 0 0)`;
      line.style.left = `${pos}%`;
      handle.style.left = `${pos}%`;
      handle.setAttribute("aria-valuenow", String(Math.round(pos)));
    };

    const posFromClientX = (clientX: number) => {
      const rect = root.getBoundingClientRect();
      if (rect.width === 0) return;
      pos = clamp(((clientX - rect.left) / rect.width) * 100);
      apply();
    };

    root.addEventListener("pointerdown", (e) => {
      root.setPointerCapture(e.pointerId);
      dragging = true;
      posFromClientX(e.clientX);
    });
    root.addEventListener("pointermove", (e) => {
      if (dragging) posFromClientX(e.clientX);
    });
    const stop = () => {
      dragging = false;
    };
    root.addEventListener("pointerup", stop);
    root.addEventListener("pointercancel", stop);

    handle.addEventListener("keydown", (e) => {
      switch (e.key) {
        case "ArrowLeft":
        case "ArrowDown":
          pos = clamp(pos - 5);
          break;
        case "ArrowRight":
        case "ArrowUp":
          pos = clamp(pos + 5);
          break;
        case "Home":
          pos = 0;
          break;
        case "End":
          pos = 100;
          break;
        default:
          return;
      }
      e.preventDefault();
      apply();
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-baslider]")
    .forEach(initSlider);
</script>
