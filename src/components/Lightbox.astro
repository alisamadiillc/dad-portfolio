---
// Shared click-to-fullscreen lightbox with in-overlay navigation. Render once
// per page. Any element carrying `data-lightbox` opens the overlay on click;
// pass `data-lightbox-group` (a JSON array of srcs) + `data-lightbox-index` to
// open a navigable set (prev/next arrows + counter). Components can also call
// `window.__lightbox.open(srcs, index, alt)` directly (e.g. a carousel's
// maximize button that opens at the currently-visible slide).
---

<div
  id="lightbox"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 opacity-0 transition-opacity duration-200"
>
  <button
    type="button"
    id="lightbox-close"
    aria-label="Close"
    class="absolute top-4 right-4 rounded-full p-2 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6"
    >
      <path d="M18 6 6 18"></path>
      <path d="m6 6 12 12"></path>
    </svg>
  </button>

  <button
    type="button"
    id="lightbox-prev"
    aria-label="Previous image"
    class="absolute top-1/2 left-4 hidden -translate-y-1/2 rounded-full border border-white/70 bg-black/50 p-2 text-white outline-none transition-colors hover:bg-black/70 focus-visible:ring-2 focus-visible:ring-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6"
    >
      <path d="m15 18-6-6 6-6"></path>
    </svg>
  </button>
  <button
    type="button"
    id="lightbox-next"
    aria-label="Next image"
    class="absolute top-1/2 right-4 hidden -translate-y-1/2 rounded-full border border-white/70 bg-black/50 p-2 text-white outline-none transition-colors hover:bg-black/70 focus-visible:ring-2 focus-visible:ring-white"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="size-6"
    >
      <path d="m9 18 6-6-6-6"></path>
    </svg>
  </button>

  <img
    id="lightbox-img"
    src=""
    alt=""
    class="max-h-[90dvh] max-w-[90vw] rounded-lg object-contain"
  />

  <span
    id="lightbox-counter"
    class="absolute bottom-4 left-1/2 hidden -translate-x-1/2 rounded-full bg-black/60 px-3 py-1 text-sm font-medium text-white"
  ></span>
</div>

<script>
  const overlay = document.getElementById("lightbox")!;
  const img = document.getElementById("lightbox-img") as HTMLImageElement;
  const closeBtn = document.getElementById("lightbox-close")!;
  const prevBtn = document.getElementById("lightbox-prev")!;
  const nextBtn = document.getElementById("lightbox-next")!;
  const counter = document.getElementById("lightbox-counter")!;
  let prevOverflow = "";

  let group: string[] = [];
  let index = 0;
  let alt = "";

  const render = () => {
    img.src = group[index] || "";
    img.alt = alt;
    const multi = group.length > 1;
    prevBtn.classList.toggle("hidden", !multi);
    nextBtn.classList.toggle("hidden", !multi);
    counter.classList.toggle("hidden", !multi);
    if (multi) counter.textContent = `${index + 1} / ${group.length}`;
  };

  const open = (srcs: string[], startIndex = 0, altText = "") => {
    group = (srcs || []).filter(Boolean);
    if (!group.length) return;
    index = Math.min(Math.max(startIndex, 0), group.length - 1);
    alt = altText;
    render();
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    requestAnimationFrame(() => overlay.classList.remove("opacity-0"));
    prevOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
  };

  const close = () => {
    overlay.classList.add("opacity-0");
    document.body.style.overflow = prevOverflow;
    window.setTimeout(() => {
      overlay.classList.add("hidden");
      overlay.classList.remove("flex");
    }, 200);
  };

  const go = (delta: number) => {
    if (group.length < 2) return;
    index = (index + delta + group.length) % group.length;
    render();
  };

  // Expose for components that navigate their own state (carousel maximize).
  (window as any).__lightbox = { open };

  // Delegated openers: any element with data-lightbox. A data-lightbox-group
  // (JSON array) makes it a navigable set; otherwise it's a single image.
  document.querySelectorAll<HTMLElement>("[data-lightbox]").forEach((el) => {
    el.addEventListener("click", () => {
      const raw = el.getAttribute("data-lightbox-group");
      let srcs: string[] | null = null;
      if (raw) {
        try {
          srcs = JSON.parse(raw);
        } catch {
          srcs = null;
        }
      }
      if (!srcs) srcs = [el.getAttribute("data-lightbox") || ""];
      const i = parseInt(el.getAttribute("data-lightbox-index") || "0", 10);
      open(srcs, i, el.getAttribute("data-lightbox-alt") || "");
    });
  });

  closeBtn.addEventListener("click", close);
  prevBtn.addEventListener("click", () => go(-1));
  nextBtn.addEventListener("click", () => go(1));
  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) close();
  });
  window.addEventListener("keydown", (e) => {
    if (overlay.classList.contains("hidden")) return;
    if (e.key === "Escape") close();
    else if (e.key === "ArrowLeft") go(-1);
    else if (e.key === "ArrowRight") go(1);
  });
</script>
